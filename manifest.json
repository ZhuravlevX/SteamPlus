{
  "manifest_version": 3,
  "name": "Steam+",
  "version": "1.0.0",
  "description": "Дополняет страницу Steam, добавляя новые функции и фичи и улучшает работу.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*",
        "https://store.steampowered.com/*"
      ],
      "js": [
        "collection/count_collection_size.js",
        "collection/count_mod_size.js",
        "extensions/delete_sih_banners.js",
        "profile/comments_rep_coloring.js",
        "workshop/social_workshop_icon.js",
        "workshop/author_stats_dlc.js",
        "workshop/author_replace_badge.js",
        "workshop/link_description_icon.js",
        "workshop/workshop_context_dlc.js"
      ]
    }
  ],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ]
}