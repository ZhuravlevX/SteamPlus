{
  "manifest_version": 3,
  "name": "Steam+",
  "version": "1.0.0",
  "description": "Дополняет страницу Steam, добавляя новые функции и фичи и улучшает работу.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*",
        "https://store.steampowered.com/*"
      ],
      "js": [
        "collection_size.js",
        "mod_size.js",
        "social_workshop.js",
        "delete_sih_banners.js",
        "author_stats_dlc.js",
        "author_replace_badge.js"
      ]
    }
  ],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ]
}