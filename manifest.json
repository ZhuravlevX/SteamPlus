{
  "manifest_version": 3,
  "name": "Steam+",
  "version": "1.0.0",
  "description": "Расширение, дополняющий страницу Steam, добавляя новые функции и фичи, улучшая его работу.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*",
        "https://store.steampowered.com/*"
      ],
      "js": [
        "extensions/delete_sih_banners.js",
        "extensions/translation_of_cost_sih_statistics.js",
        "profile/comments_rep_coloring.js",
        "workshop/count_collection_size.js",
        "workshop/count_mod_size.js",
        "workshop/social_workshop_icon.js",
        "workshop/author_stats_dlc.js",
        "workshop/author_replace_badge.js",
        "workshop/link_description_icon.js",
        "workshop/workshop_context_dlc.js"
      ]
    }
  ],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ]
}