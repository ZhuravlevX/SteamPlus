{
    "manifest_version": 3,
    "name": "Steam Gold",
    "version": "1.0.0",
    "description": "Дополняет и улучшает работу в Steam Workshop.",
    "content_scripts": [
      {
        "matches": [
          "https://steamcommunity.com/sharedfiles/filedetails/*",
          "https://steamcommunity.com/workshop/filedetails/*"
        ],
        "js": [
          "collection_size.js",
          "mod_size.js",
          "social_workshop.js",
          "author_stats_dlc.js",
          "author_replace_badge.js"
        ]
      }
    ],
    "host_permissions": [
      "https://steamcommunity.com/*"
    ]
  }